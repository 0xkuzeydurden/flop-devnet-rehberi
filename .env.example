# Example only. Do not start services until the official manifest, network identity
# and model policy have been checked. Devnet has no rewards or airdrop weight.
# Frozen image references observed on 2026-11-04; they are not an auto-update policy.
FLOP_CLI_IMAGE=ghcr.io/flop-labs/flop-core/cli:v0.1.220@sha256:c8f3456c48d41cec9d0229d1e1dd9eb8d6247a22f350c51078d85f129601bbbd
FLOP_WORKER_IMAGE=ghcr.io/flop-labs/flop-core/miner-worker:v0.1.238@sha256:3ba91ea4ba4d57c2d91e3d42bda0aae07d1bdbcc5bbe1a816f01908c45c215ce
FLOP_BACKEND_IMAGE=ghcr.io/flop-labs/flop-core/miner-vllm-toploc:v0.1.239@sha256:9b6c6dfc4d77ac37583d28dbfdcb4fa96207ae95956c1e859b7d5e9eef6f7b9e

FLOP_RPC=wss://rpc.devnet.flop.network
FLOP_MAILBOX_URL=https://mailbox.devnet.flop.network
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
OPENROUTER_MODEL_SLUG=qwen/qwen2.5-0.5b-instruct
MODEL_HASH=0x1a52c1abe781db051e70ae357f72bb70161ca0c092df0b618f22a9292ba63306
