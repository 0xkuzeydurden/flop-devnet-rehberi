TOPLOC_PRECISION=bf16
DECODE_POLICY_HASH=0xeca6a3f9c5a9fa1556892182ffef15b1273c075146a2d1a87814ae83ecea3053
# Filled with the exact JSON preimage from the official manifest by prepare-env.py.
DECODE_POLICY_JSON=

# Set a unique operator name and a stable, reachable HTTPS hostname (no scheme).
WORKER_NAME=
SESSION_PUBLIC_HOST=

# Relative paths resolve from the repository directory. Existing files/directories
# are required; Compose must not create an empty directory in place of a key file.
FLOP_CHECKPOINT_DIR=./private/checkpoint
FLOP_SIGNER_FILE=./private/miner.seed
FLOP_ENCLAVE_FILE=./private/session.seed

# Generate separate private values locally. Never paste real values into GitHub.
INFERENCE_API_KEY=
SESSION_AUTH_TOKEN=
